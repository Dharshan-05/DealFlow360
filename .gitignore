# ==========================================
# DealFlow360 Monorepo .gitignore
# ==========================================

# Environment & Secrets (Never commit secrets)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx

# Dependency Directories
node_modules/
jspm_packages/

# Next.js & Frontend Build Outputs
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/
*.tsbuildinfo
.next/
out/
build/
dist/
.turbo/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Process Management, Runtime & Sockets (Phase 459 / 467 / 468)
*.pid
*.sock
*.socket
logs/
*.log
deploy/logs/

# Temporary and Cache files
*.tmp
*.temp

