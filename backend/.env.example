# ==========================================
# DealFlow360 Backend Environment Variables
# Foundation Configuration (G02: Phases 006–010)
# ==========================================

# Environment Mode: development | testing | production
ENVIRONMENT=development
DEBUG=true

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# API Versioning Prefix
API_V1_STR=/api/v1
PROJECT_NAME=DealFlow360

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
