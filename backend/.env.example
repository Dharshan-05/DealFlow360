# ==========================================
# DealFlow360 Backend Environment Variables
# Foundation Configuration (G03: Phases 011–015)
# ==========================================

# Environment Mode: development | testing | production
ENVIRONMENT=development
DEBUG=true

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# API Versioning Prefix
API_V1_STR=/api/v1
PROJECT_NAME=DealFlow360

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Relational Database Connection (PostgreSQL)
# Format: postgresql+psycopg://username:password@localhost:5432/database_name
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/dealflow360
DB_ECHO_LOG=false

# Security & JWT Authentication (G06: Phases 026–030)
# Generate a cryptographically secure 256-bit secret for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

